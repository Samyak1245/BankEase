<div class="page-header">
  <div>
    <h1>Branches</h1>
    <p class="text-muted mb-0">Add, edit and delete bank branches</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBranchModal">
    <i class="bi bi-plus-lg"></i> Add Branch
  </button>
</div>

<div class="card panel-card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Branch Name</th>
          <th>City</th>
          <th>Address</th>
          <th>Employees</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!branches.length) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No branches found.</td></tr>
        <% } %>
        <% branches.forEach(function(b) { %>
          <tr>
            <td><%= b.branch_id %></td>
            <td><%= b.branch_name %></td>
            <td><%= b.city %></td>
            <td><%= b.address || "-" %></td>
            <td><%= b.employee_count %></td>
            <td class="text-nowrap">
              <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editBranch<%= b.branch_id %>">Edit</button>
              <form class="d-inline" method="POST" action="/branches/<%= b.branch_id %>/delete" onsubmit="return confirm('Delete this branch?');">
                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>

          <div class="modal fade" id="editBranch<%= b.branch_id %>" tabindex="-1">
            <div class="modal-dialog">
              <form class="modal-content" method="POST" action="/branches/<%= b.branch_id %>/edit">
                <div class="modal-header">
                  <h5 class="modal-title">Edit Branch</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  <div class="mb-3">
                    <label class="form-label">Branch Name</label>
                    <input class="form-control" name="branch_name" required value="<%= b.branch_name %>">
                  </div>
                  <div class="mb-3">
                    <label class="form-label">City</label>
                    <input class="form-control" name="city" required value="<%= b.city %>">
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Address</label>
                    <input class="form-control" name="address" value="<%= b.address || '' %>">
                  </div>
                </div>
                <div class="modal-footer">
                  <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                  <button class="btn btn-primary" type="submit">Update</button>
                </div>
              </form>
            </div>
          </div>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="addBranchModal" tabindex="-1">
  <div class="modal-dialog">
    <form class="modal-content" method="POST" action="/branches">
      <div class="modal-header">
        <h5 class="modal-title">Add Branch</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Branch Name</label>
          <input class="form-control" name="branch_name" required>
        </div>
        <div class="mb-3">
          <label class="form-label">City</label>
          <input class="form-control" name="city" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Address</label>
          <input class="form-control" name="address">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" type="submit">Save Branch</button>
      </div>
    </form>
  </div>
</div>
