<div class="page-header">
  <div>
    <h1>Loans</h1>
    <p class="text-muted mb-0">Apply for loans and update approval status</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addLoanModal">
    <i class="bi bi-plus-lg"></i> Apply for Loan
  </button>
</div>

<form class="search-bar" method="GET" action="/loans">
  <input class="form-control" type="search" name="q" value="<%= search %>" placeholder="Search by customer, type or status">
  <button class="btn btn-outline-primary" type="submit">Search</button>
  <a class="btn btn-outline-secondary" href="/loans">Reset</a>
</form>

<div class="card panel-card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Loan ID</th>
          <th>Customer</th>
          <th>Type</th>
          <th>Amount (INR)</th>
          <th>Interest %</th>
          <th>Tenure</th>
          <th>Status</th>
          <th>Applied</th>
          <th>Update Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (!loans.length) { %>
          <tr><td colspan="9" class="text-center text-muted py-4">No loans found.</td></tr>
        <% } %>
        <% loans.forEach(function(l) { %>
          <tr>
            <td><%= l.loan_id %></td>
            <td><%= l.customer_name %></td>
            <td><%= l.loan_type %></td>
            <td>₹ <%= Number(l.loan_amount).toLocaleString("en-IN") %></td>
            <td><%= l.interest_rate %></td>
            <td><%= l.tenure_months %> months</td>
            <td>
              <span class="badge text-bg-<%= l.status === 'Approved' ? 'success' : (l.status === 'Rejected' ? 'danger' : 'warning') %>">
                <%= l.status %>
              </span>
            </td>
            <td><%= l.application_date || "-" %></td>
            <td>
              <form class="d-flex gap-1" method="POST" action="/loans/<%= l.loan_id %>/status">
                <select class="form-select form-select-sm" name="status">
                  <option value="Pending" <%= l.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="Approved" <%= l.status === 'Approved' ? 'selected' : '' %>>Approved</option>
                  <option value="Rejected" <%= l.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                </select>
                <button class="btn btn-sm btn-outline-primary" type="submit">Save</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="addLoanModal" tabindex="-1">
  <div class="modal-dialog">
    <form class="modal-content" method="POST" action="/loans">
      <div class="modal-header">
        <h5 class="modal-title">Apply for Loan</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Customer</label>
          <select class="form-select" name="customer_id" required>
            <option value="">Select customer</option>
            <% customers.forEach(function(c) { %>
              <option value="<%= c.customer_id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Loan Type</label>
          <select class="form-select" name="loan_type" required>
            <option value="Home">Home</option>
            <option value="Education">Education</option>
            <option value="Personal">Personal</option>
            <option value="Vehicle">Vehicle</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Loan Amount (INR)</label>
          <input class="form-control" type="number" name="loan_amount" min="0.01" step="0.01" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Interest Rate (%)</label>
          <input class="form-control" type="number" name="interest_rate" min="0" step="0.01" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Tenure (months)</label>
          <input class="form-control" type="number" name="tenure_months" min="1" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Application Date</label>
          <input class="form-control" type="date" name="application_date">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" type="submit">Submit Application</button>
      </div>
    </form>
  </div>
</div>
