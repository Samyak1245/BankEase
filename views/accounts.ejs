<div class="page-header">
  <div>
    <h1>Accounts</h1>
    <p class="text-muted mb-0">Create and manage savings and current accounts</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAccountModal">
    <i class="bi bi-plus-lg"></i> Create Account
  </button>
</div>

<form class="search-bar" method="GET" action="/accounts">
  <input class="form-control" type="search" name="q" value="<%= search %>" placeholder="Search by ID, customer, type or status">
  <button class="btn btn-outline-primary" type="submit">Search</button>
  <a class="btn btn-outline-secondary" href="/accounts">Reset</a>
</form>

<% if (detailsAccount) { %>
  <div class="card panel-card mb-4">
    <div class="card-header d-flex justify-content-between">
      <span>Account #<%= detailsAccount.account_id %> details</span>
      <a href="/accounts" class="btn btn-sm btn-outline-secondary">Close</a>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4"><strong>Customer:</strong> <%= detailsAccount.customer_name %></div>
        <div class="col-md-4"><strong>Type:</strong> <%= detailsAccount.account_type %></div>
        <div class="col-md-4"><strong>Status:</strong> <%= detailsAccount.status %></div>
        <div class="col-md-4 mt-2"><strong>Balance:</strong> ₹ <%= Number(detailsAccount.balance).toLocaleString("en-IN") %></div>
        <div class="col-md-4 mt-2"><strong>Opened:</strong> <%= detailsAccount.opening_date || "-" %></div>
        <div class="col-md-4 mt-2"><strong>Email:</strong> <%= detailsAccount.customer_email %></div>
      </div>
      <h6 class="mt-4">Transactions for this account</h6>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>ID</th><th>Type</th><th>Amount</th><th>Date</th><th>Description</th>
            </tr>
          </thead>
          <tbody>
            <% if (!accountTransactions.length) { %>
              <tr><td colspan="5" class="text-muted">No transactions.</td></tr>
            <% } %>
            <% accountTransactions.forEach(function(tx) { %>
              <tr>
                <td><%= tx.transaction_id %></td>
                <td><%= tx.transaction_type %></td>
                <td>₹ <%= Number(tx.amount).toLocaleString("en-IN") %></td>
                <td><%= tx.transaction_date %></td>
                <td><%= tx.description || "-" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<div class="card panel-card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Account ID</th>
          <th>Customer Name</th>
          <th>Account Type</th>
          <th>Balance (INR)</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!accounts.length) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No accounts found.</td></tr>
        <% } %>
        <% accounts.forEach(function(a) { %>
          <tr>
            <td><%= a.account_id %></td>
            <td><%= a.customer_name %></td>
            <td><%= a.account_type %></td>
            <td>₹ <%= Number(a.balance).toLocaleString("en-IN") %></td>
            <td><span class="badge text-bg-<%= a.status === 'Active' ? 'success' : 'secondary' %>"><%= a.status %></span></td>
            <td class="text-nowrap">
              <a class="btn btn-sm btn-outline-secondary" href="/accounts/<%= a.account_id %>">View</a>
              <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editAccount<%= a.account_id %>">Edit</button>
            </td>
          </tr>

          <div class="modal fade" id="editAccount<%= a.account_id %>" tabindex="-1">
            <div class="modal-dialog">
              <form class="modal-content" method="POST" action="/accounts/<%= a.account_id %>/edit">
                <div class="modal-header">
                  <h5 class="modal-title">Edit Account #<%= a.account_id %></h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  <p class="text-muted">Balance is changed only through deposit/withdraw.</p>
                  <div class="mb-3">
                    <label class="form-label">Account Type</label>
                    <select class="form-select" name="account_type" required>
                      <option value="Savings" <%= a.account_type === 'Savings' ? 'selected' : '' %>>Savings</option>
                      <option value="Current" <%= a.account_type === 'Current' ? 'selected' : '' %>>Current</option>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status" required>
                      <option value="Active" <%= a.status === 'Active' ? 'selected' : '' %>>Active</option>
                      <option value="Frozen" <%= a.status === 'Frozen' ? 'selected' : '' %>>Frozen</option>
                      <option value="Closed" <%= a.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Opening Date</label>
                    <input class="form-control" type="date" name="opening_date" value="<%= a.opening_date || '' %>">
                  </div>
                </div>
                <div class="modal-footer">
                  <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                  <button class="btn btn-primary" type="submit">Update</button>
                </div>
              </form>
            </div>
          </div>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="addAccountModal" tabindex="-1">
  <div class="modal-dialog">
    <form class="modal-content" method="POST" action="/accounts">
      <div class="modal-header">
        <h5 class="modal-title">Create Account</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Customer</label>
          <select class="form-select" name="customer_id" required>
            <option value="">Select customer</option>
            <% customers.forEach(function(c) { %>
              <option value="<%= c.customer_id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Account Type</label>
          <select class="form-select" name="account_type" required>
            <option value="Savings">Savings</option>
            <option value="Current">Current</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Opening Balance (INR)</label>
          <input class="form-control" type="number" name="balance" min="0" step="0.01" value="0" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Opening Date</label>
          <input class="form-control" type="date" name="opening_date">
        </div>
        <input type="hidden" name="status" value="Active">
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" type="submit">Create Account</button>
      </div>
    </form>
  </div>
</div>
