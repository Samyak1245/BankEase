<div class="page-header">
  <div>
    <h1>Loan Payments</h1>
    <p class="text-muted mb-0">Record EMI / payments against approved loans</p>
  </div>
</div>

<div class="card panel-card mb-4">
  <div class="card-header">Record Payment</div>
  <div class="card-body">
    <form method="POST" action="/loan-payments">
      <div class="row g-3">
        <div class="col-md-5">
          <label class="form-label">Loan</label>
          <select class="form-select" name="loan_id" required>
            <option value="">Select loan</option>
            <% loans.forEach(function(l) { %>
              <option value="<%= l.loan_id %>">
                #<%= l.loan_id %> - <%= l.customer_name %> (<%= l.loan_type %>, <%= l.status %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Amount (INR)</label>
          <input class="form-control" type="number" name="amount" min="0.01" step="0.01" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Payment Date</label>
          <input class="form-control" type="date" name="payment_date">
        </div>
        <div class="col-md-1 d-flex align-items-end">
          <button class="btn btn-primary w-100" type="submit">Save</button>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="card panel-card">
  <div class="card-header">Payment History</div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Payment ID</th>
          <th>Loan ID</th>
          <th>Amount (INR)</th>
          <th>Payment Date</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (!payments.length) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No payments recorded.</td></tr>
        <% } %>
        <% payments.forEach(function(p) { %>
          <tr>
            <td><%= p.payment_id %></td>
            <td><%= p.loan_id %></td>
            <td>₹ <%= Number(p.amount).toLocaleString("en-IN") %></td>
            <td><%= p.payment_date || "-" %></td>
            <td><span class="badge text-bg-success"><%= p.payment_status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
