<div class="page-header">
  <div>
    <h1>Transactions</h1>
    <p class="text-muted mb-0">Deposit or withdraw money. Balance and history stay in sync.</p>
  </div>
</div>

<div class="card panel-card mb-4">
  <div class="card-header">New Transaction</div>
  <div class="card-body">
    <form id="transactionForm" method="POST" action="/transactions/deposit">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Account</label>
          <select class="form-select" name="account_id" required>
            <option value="">Select account</option>
            <% accounts.forEach(function(a) { %>
              <option value="<%= a.account_id %>">
                #<%= a.account_id %> - <%= a.customer_name %> (₹ <%= Number(a.balance).toLocaleString("en-IN") %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Transaction Type</label>
          <select class="form-select" id="transactionType" required>
            <option value="deposit">Deposit</option>
            <option value="withdraw">Withdraw</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Amount (INR)</label>
          <input class="form-control" type="number" name="amount" min="0.01" step="0.01" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Description</label>
          <input class="form-control" name="description" placeholder="Optional">
        </div>
      </div>
      <button class="btn btn-primary mt-3" type="submit">Submit Transaction</button>
    </form>
  </div>
</div>

<div class="card panel-card">
  <div class="card-header">Transaction History</div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Transaction ID</th>
          <th>Account ID</th>
          <th>Type</th>
          <th>Amount (INR)</th>
          <th>Date</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <% if (!transactions.length) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No transactions yet.</td></tr>
        <% } %>
        <% transactions.forEach(function(tx) { %>
          <tr>
            <td><%= tx.transaction_id %></td>
            <td><%= tx.account_id %></td>
            <td>
              <span class="badge <%= tx.transaction_type === 'Deposit' ? 'text-bg-success' : 'text-bg-warning' %>">
                <%= tx.transaction_type %>
              </span>
            </td>
            <td>₹ <%= Number(tx.amount).toLocaleString("en-IN") %></td>
            <td><%= tx.transaction_date %></td>
            <td><%= tx.description || "-" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
